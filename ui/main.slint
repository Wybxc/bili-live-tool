import {
    Button,
    VerticalBox,
    LineEdit,
    AboutSlint,
    Spinner,
    HorizontalBox,
    ComboBox,
} from "std-widgets.slint";

enum LoginStatus {
    Waiting,
    Confirming,
    Expired,
    Success,
}

export global LoginLogic {
    in-out property <image> qr-code;
    in-out property <LoginStatus> login-status: LoginStatus.Waiting;
    in-out property <string> oauth-key;
    in-out property <bool> qr-code-ready: false;
    callback refresh-qr-code();
    callback logout();
}

enum RoomIdStatus {
    Fetching,
    Ok,
    Failed,
}

export global UserLogic {
    in-out property <image> face;
    in-out property <string> uname;
    in-out property <string> room-id;
    in-out property <RoomIdStatus> room-id-status: RoomIdStatus.Fetching;
}

export global LiveLogic {
    in-out property <string> title;
    in-out property <[string]> area-list;
    in-out property <string> selected-area;
    in-out property <[string]> sub-area-list;
    in-out property <string> selected-sub-area;
    callback update-sub-area-list();
    callback update-live-area();
    callback update-live-title();
}

component LoginPage {
    VerticalBox {
        Text {
            text: LoginLogic.login-status == LoginStatus.Waiting ? "请使用B站APP扫码登录" :      //
                   LoginLogic.login-status == LoginStatus.Confirming ? "请在手机上确认登录" :     //
                   LoginLogic.login-status == LoginStatus.Expired ? "二维码已过期，请刷新" :       //
                   LoginLogic.login-status == LoginStatus.Success ? "登录成功！" : "未知状态";    //
            horizontal-alignment: center;
        }

        if LoginLogic.qr-code-ready:
        Image {
            width: 300px;
            height: 300px;
            source: LoginLogic.qr-code;
            image-fit: contain;
            image-rendering: pixelated;
        }

        if !LoginLogic.qr-code-ready:
        Rectangle {
            width: 300px;
            height: 300px;
            background: #eee;
            border-radius: 10px;

            Spinner {
                indeterminate: true;
            }
        }

        Button {
            text: "刷新二维码";
            clicked => LoginLogic.refresh-qr-code();
        }
    }
}

component MainPage {
    VerticalBox {
        HorizontalBox {
            Rectangle {
                width: 40px;
                height: 40px;
                clip: true;
                border-radius: 20px;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: UserLogic.face;
                }
            }

            Text {
                text: UserLogic.uname;
                font-size: 15px;
                vertical-alignment: center;
            }

            Button {
                text: "退出登录";
                clicked => LoginLogic.logout();
            }
        }

        VerticalBox {
            Text {
                text: "房间号: " + (UserLogic.room-id-status == RoomIdStatus.Fetching ? "获取中..." :  //
                       UserLogic.room-id-status == RoomIdStatus.Ok ? UserLogic.room-id :  //
                       UserLogic.room-id-status == RoomIdStatus.Failed ? "获取失败" : "未知状态");    //
            }

            HorizontalBox {
                padding: 0;

                Text {
                    text: "标题";
                    vertical-alignment: center;
                }

                LineEdit {
                    text <=> LiveLogic.title;
                    placeholder-text: "请输入直播标题";
                }

                Button {
                    text: "更新";
                    clicked => LiveLogic.update-live-title();
                }
            }

            HorizontalBox {
                padding: 0;

                Text {
                    text: "分区";
                    vertical-alignment: center;
                }

                ComboBox {
                    model: LiveLogic.area-list;
                    current-value <=> LiveLogic.selected-area;
                    selected => LiveLogic.update-sub-area-list();
                }

                ComboBox {
                    model: LiveLogic.sub-area-list;
                    current-value <=> LiveLogic.selected-sub-area;
                }

                Button {
                    text: "更新";
                    clicked => LiveLogic.update-live-area();
                }
            }

            Button {
                text: "开始直播";
                primary: true;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Bili Live Tool";

    if LoginLogic.login-status != LoginStatus.Success: LoginPage { }
    if LoginLogic.login-status == LoginStatus.Success: MainPage { }
}
